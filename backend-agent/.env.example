# 复制为 .env 后按需修改；所有变量前缀固定为 PET_AGENT_
# 1) 模型（任意 OpenAI 兼容端点：DeepSeek / 通义 / vLLM / Ollama）
PET_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
PET_AGENT_LLM_API_KEY=
PET_AGENT_LLM_MODEL=deepseek-chat

# 2) 业务后端（Java 服务），工具通过它读数据，权限沿用用户 satoken
PET_AGENT_BACKEND_BASE_URL=http://localhost:8080/api/v1

# 3) Agent 表存储：memory(默认,零依赖) | mysql
PET_AGENT_REPO_BACKEND=memory
PET_AGENT_MYSQL_DSN=mysql://root:<本机口令>@127.0.0.1:3306/petlumina

# 4) 对话检查点（LangGraph checkpointer）
PET_AGENT_REDIS_URL=redis://127.0.0.1:6379/0

# 5) 调度上限
PET_AGENT_MAX_TOOL_HOPS=6

# 6) 预算与配额（S1.6 P1）
PET_AGENT_RUN_TOKEN_BUDGET=30000
PET_AGENT_RATE_LIMIT_ENABLED=true
PET_AGENT_RATE_LIMIT_PER_MINUTE=20
PET_AGENT_RATE_LIMIT_PER_DAY=300
# 单副本用 memory；多副本必须切 redis，否则每个副本各算一份配额
PET_AGENT_RATE_LIMIT_BACKEND=memory

# 7) 事件总线：memory(默认) | redis(Redis Stream，跨进程续传)
PET_AGENT_EVENT_BACKEND=memory

# 9) 旁路任务队列（S1.9）：off(默认，同步执行) | memory(进程内) | redis(重启不丢)
PET_AGENT_TASK_BACKEND=off
PET_AGENT_TASK_QUEUE_SIZE=1000
PET_AGENT_TASK_MAX_ATTEMPTS=3
# 8) 熔断（S1.8 P2）：连续 N 次可重试失败后打开，冷却期过了放一个探测
PET_AGENT_CIRCUIT_THRESHOLD=5
PET_AGENT_CIRCUIT_COOLDOWN_S=30

# 10) 文档问答（S1.15 A3）
# hash(默认，本地确定性嵌入，零网络) | openai(兼容 /embeddings 的接口)
PET_AGENT_EMBED_BACKEND=hash
PET_AGENT_EMBED_MODEL=text-embedding-3-small
PET_AGENT_EMBED_DIM=256
# 上传文件落盘目录（相对 backend-agent/），生产建议挂卷
PET_AGENT_DOC_STORAGE_DIR=data/docs
PET_AGENT_DOC_MAX_BYTES=20971520
